{
  "name": "skill-forge-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "prepare": "svelte-kit sync || echo ''",
    "catalog": "node scripts/catalog.mjs",
    "test": "node --test tests/*.test.mjs",
    "guard": "node --test tests/guard.build.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.6.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
