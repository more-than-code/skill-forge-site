  "color": {
    "$type": "color",
    "bg": {
      "$value": "#F7F6F2",
      "$description": "Page background behind every plane and card. Site: paper.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#0F131C"
        }
      }
    },
    "plane": {
      "$value": "#F1F0EC",
      "$description": "Large app regions (sidebar, rail) one step above bg. Site: between paper and soft (hand-derived).",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#141821"
        }
      }
    },
    "surface": {
      "$value": "#FCFCFA",
      "$description": "Cards, panels, inputs: the default reading surface. Never pure white or black. Site: card (light) / soft (dark).",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#1A1E27"
        }
      }
    },
    "surface-2": {
      "$value": "#ECEBE7",
      "$description": "Nested or hovered surface inside a surface. Site: soft (light) / card (dark).",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#22262F"
        }
      }
    },
    "surface-3": {
      "$value": "#E3E2DE",
      "$description": "Pressed, selected or deepest nested surface. Site: one step darker / lighter (hand-derived).",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#2C3039"
        }
      }
    },
    "ink": {
      "$value": "#1E1D1B",
      "$description": "Primary text and icons. Site: ink.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#F3F2EE"
        }
      }
    },
    "ink-2": {
      "$value": "#635F59",
      "$description": "Secondary text: labels, metadata. Site: ink-2.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#B0B9CA"
        }
      }
    },
    "ink-3": {
      "$value": "#635F59",
      "$description": "Captions and placeholders; still 4.5:1 on every surface. Site: no third ink level in brand-palette-roles: same as ink-2.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#B0B9CA"
        }
      }
    },
    "ink-disabled": {
      "$value": "#9B9A95",
      "$description": "Text of disabled controls only (exempt from contrast minimums; pair with a non-colour cue). Site: preset.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#6B6A66"
        }
      }
    },
    "line": {
      "$value": "#E3E2DE",
      "$description": "Decorative divider between rows and sections.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#2C3039"
        }
      }
    },
    "line-2": {
      "$value": "#D9D8D5",
      "$description": "Stronger decorative divider; not enough on its own to identify a control.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#363A44"
        }
      }
    },
    "line-strong": {
      "$value": "#7D7A74",
      "$description": "Border of a control when the border is its only visual cue (3:1). Site: hand-derived to reach 3:1.",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#7A8291"
        }
      }
    },
    "edge-color": {
      "$value": "#D9D8D5",
      "$description": "Colour of the 1px inset hairline (--edge).",
      "$extensions": {
        "com.skillforgecloud.modes": {
          "dark": "#2C3039"
        }
      }
    },
    "ring": {
